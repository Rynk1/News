# ---------------------------------------------------------------------------
# NewsIntel environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# IMPORTANT: This is a Vite front-end. Only variables prefixed with `VITE_`
# are exposed to the browser bundle, and anything exposed to the browser is
# PUBLIC. Do NOT put secret keys (OpenAI, Stripe secret, DB passwords) behind
# a `VITE_` prefix — those belong on a backend server (see the "Server /
# backend" section below, which the `src/config/environment.ts` blueprint
# reads via `process.env` once a backend exists).
# ---------------------------------------------------------------------------

# ---- Client (safe to ship to the browser) --------------------------------
# Enables the Tempo visual editor routes when set to "true".
VITE_TEMPO=false
# Base path the app is served under (used for non-dev builds).
VITE_BASE_PATH=/
# Public URL of your backend API (once it exists).
VITE_API_BASE_URL=http://localhost:3000/api
# Supabase (anon/public key is safe for the client).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe publishable key is safe for the client.
VITE_STRIPE_PUBLISHABLE_KEY=

# ---- Server / backend (KEEP SECRET — never expose to the client) ---------
# These are consumed server-side only. Required set is validated by
# `validateConfig()` in src/config/environment.ts.
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=change-me-in-production

# Data stores
DATABASE_URL=postgresql://user:password@localhost:5432/newsintel
REDIS_URL=redis://localhost:6379
SUPABASE_PROJECT_ID=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# News data sources
NEWS_API_KEY=
SERP_API_KEY=
RAPID_API_KEY=

# Payments (secret side)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SENDGRID_API_KEY=
FROM_EMAIL=noreply@newsintel.com

# Monitoring
SENTRY_DSN=
MIXPANEL_TOKEN=

# File storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=

# Security / limits
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature flags
ENABLE_REAL_TIME_MONITORING=false
ENABLE_AI_SYNTHESIS=false
ENABLE_ADVANCED_ANALYTICS=false
